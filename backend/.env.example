# Gnani AI (Vachana) API Credentials
# Obtain your API key from the Gnani developer console (https://docs.gnani.ai)
GNANI_API_KEY=your_gnani_api_key_here

# Google Gemini API Credentials
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: REST endpoint overrides (defaults shown)
# GNANI_STT_ENDPOINT=https://api.vachana.ai/stt/v3
# GNANI_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference

# Production CORS Configuration (Render)
# Prefer exact production frontend origin(s), comma-separated:
CORS_ORIGINS=https://your-vercel-app.vercel.app
# Optional: enable ONLY if testing Vercel PR preview deployments (scope regex to your project name):
# CORS_ORIGIN_REGEX=https://bimasakshi-[a-z0-9-]+\.vercel\.app
